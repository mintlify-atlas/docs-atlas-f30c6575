  "keyFeatures": [
    "Full Twilio REST API coverage via auto-generated client",
    "TwiML generation for Voice, Messaging, and Fax",
    "JWT token generation (AccessToken, ClientCapability, TaskRouter)",
    "Webhook request validation with Rack middleware support",
    "Automatic pagination for list resources",
    "Customizable HTTP client via Faraday adapters",
    "Support for Twilio Global Infrastructure (region/edge routing)",
    "OAuth 2.0 Client Credentials Flow support"
  ],
  "publicApiSurface": [
    "Twilio::REST::Client",
    "Twilio::TwiML::VoiceResponse",
    "Twilio::TwiML::MessagingResponse",
    "Twilio::TwiML::FaxResponse",
    "Twilio::JWT::AccessToken",
    "Twilio::JWT::ClientCapability",
    "Twilio::JWT::TaskRouterCapability",
    "Twilio::Security::RequestValidator",
    "Rack::TwilioWebhookAuthentication",
